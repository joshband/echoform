{
  "scenario_version": "1.0",
  "id": "echoform_mix_sweep",
  "name": "Echoform Mix Parameter - Dry/Wet Crossfade Validation",
  "category": "delay_reverb",
  "description": "Validates mix parameter (0.0-1.0) controls dry/wet balance correctly. Tests at full dry (0.0), balanced (0.5), and full wet (1.0) extremes.",
  "capability_requirements": {
    "required_effect_types": [
      "DELAY"
    ],
    "required_behaviors": [
      "STATEFUL"
    ],
    "excluded_behaviors": [],
    "notes": "Tests mix parameter range: 0.0 (all dry) to 1.0 (all wet)"
  },
  "stimulus": {
    "stimulus_id": "multitone",
    "stimulus_variant": "harmonic",
    "parameters": {
      "fundamental_hz": 110.0,
      "num_harmonics": 5,
      "amplitude": 0.4,
      "duration_seconds": 3.0
    }
  },
  "parameter_variations": {
    "Feedback": 0.5,
    "Size": 0.167,
    "Feedback Mode": 0.5,
    "Scan": 0.3
  },

  "parameter_automation": [
    {
      "parameter_name": "Mix",
      "parameter_index": 0,
      "type": "envelope",
      "points": [
        {
          "time": 0.5,
          "value": 0.0
        },
        {
          "time": 2.5,
          "value": 1.0
        }
      ]
    }
  ],
  "analysis_windows": {
    "full_response": {
      "type": "time_range",
      "start_seconds": 0.0,
      "end_seconds": 3.0,
      "description": "Full wet mix (1.0) response"
    },
    "early_response": {
      "type": "time_range",
      "start_seconds": 0.0,
      "end_seconds": 0.5,
      "description": "Initial wet signal"
    },
    "steady_state": {
      "type": "time_range",
      "start_seconds": 1.0,
      "end_seconds": 2.5,
      "description": "Steady state with feedback"
    }
  },
  "expected_invariants": {
    "strong_wet_signal": {
      "metric": "rms_energy",
      "window": "full_response",
      "threshold": {
        "min": -50.0
      },
      "severity": "hard_fail",
      "description": "At mix=1.0, wet signal should dominate (strong delay/feedback audible)"
    },
    "no_clipping": {
      "metric": "peak_level",
      "window": "full_response",
      "threshold": {
        "max": 1.0
      },
      "severity": "hard_fail",
      "description": "Full wet should not clip (mix=1.0 with feedback=0.5)"
    },
    "feedback_active": {
      "metric": "rms_variance",
      "window": "steady_state",
      "threshold": {
        "min": 0.001,
        "max": 0.5
      },
      "severity": "soft_warn",
      "description": "Feedback should create temporal variation in wet mix"
    },
    "stable_feedback": {
      "metric": "monotonic_tail_decay",
      "window": "steady_state",
      "threshold": {
        "max_upward_steps": 300,
        "upward_step_db_max": 3.0
      },
      "severity": "soft_warn",
      "description": "Feedback should be stable at 0.5 (no runaway or oscillation)"
    }
  },
  "baseline_tracking": {
    "enabled": true,
    "compare_against": [
      "golden"
    ],
    "provenance": {
      "stimulus_id": "multitone.harmonic",
      "scenario_id": "echoform_mix_sweep",
      "capability_class": "mix_parameter_wet_extreme"
    }
  },
  "use_cases": [
    "Verify mix parameter controls wet level (test at 1.0 = full wet)",
    "Test wet-only operation without dry signal",
    "Validate feedback stability at full wet mix",
    "Ensure no clipping at extreme mix values"
  ],
  "pass_criteria": "Strong wet signal with stable feedback, no clipping, preserved harmonic structure",
  "example_failures": [
    "Weak signal \u2192 mix parameter not working",
    "Clipping \u2192 gain staging issue at full wet",
    "Unstable feedback \u2192 oscillation at mix=1.0",
    "No harmonics \u2192 spectral corruption"
  ]
}
