{
  "scenario_version": "1.0",
  "id": "echoform_parameter_smoothing_contract",
  "name": "Echoform Parameter Smoothing Contract",
  "category": "contract",
  "description": "Contract baseline for rapid automation handling. Validates smoothing and transition stability under repeated edge changes.",

  "capability_requirements": {
    "required_effect_types": ["DELAY"],
    "required_behaviors": ["STATEFUL", "TIME_VARYING"],
    "excluded_behaviors": [],
    "notes": "Uses dense automation over high-impact controls."
  },

  "stimulus": {
    "stimulus_id": "noise",
    "stimulus_variant": "white",
    "parameters": {
      "amplitude": 0.3,
      "duration_seconds": 3.0
    }
  },

  "parameter_variations": {
    "Mix": 0.5,
    "Feedback": 0.45
  },

  "parameter_automation": [
    {
      "parameter_index": 0,
      "type": "envelope",
      "points": [
        {"time": 0.0, "value": 0.1},
        {"time": 0.2, "value": 0.9},
        {"time": 0.4, "value": 0.2},
        {"time": 0.6, "value": 0.85},
        {"time": 0.8, "value": 0.3},
        {"time": 1.0, "value": 0.8}
      ]
    },
    {
      "parameter_index": 4,
      "type": "envelope",
      "points": [
        {"time": 0.0, "value": 0.2},
        {"time": 0.25, "value": 0.8},
        {"time": 0.5, "value": 0.25},
        {"time": 0.75, "value": 0.75},
        {"time": 1.0, "value": 0.3}
      ]
    }
  ],

  "analysis_windows": {
    "exercise_window": {
      "type": "time_range",
      "start_seconds": 0.1,
      "end_seconds": 2.8,
      "description": "Automation exercise window"
    }
  },

  "expected_invariants": {
    "contract_finite": {
      "metric": "non_finite",
      "window": "exercise_window",
      "threshold": {
        "max": 0
      },
      "severity": "hard_fail",
      "description": "Output must remain finite during automation"
    },
    "contract_peak_budget": {
      "metric": "peak_level",
      "window": "exercise_window",
      "threshold": {
        "max": 1.0
      },
      "severity": "hard_fail",
      "description": "Rapid automation should not clip"
    },
    "contract_discontinuities": {
      "metric": "discontinuity_count",
      "window": "exercise_window",
      "threshold": {
        "max_count": 3000,
        "detection_threshold_db": -30.0
      },
      "severity": "soft_warn",
      "description": "Transition artifacts should stay bounded"
    },
    "contract_dc_bias": {
      "metric": "dc_offset",
      "window": "exercise_window",
      "threshold": {
        "max": 0.01
      },
      "severity": "soft_warn",
      "description": "Automation should not introduce sustained DC bias"
    }
  },

  "baseline_tracking": {
    "enabled": true,
    "compare_against": ["golden"],
    "provenance": {
      "scenario_id": "echoform_parameter_smoothing_contract",
      "capability_class": "smoothing_contract"
    }
  }
}
